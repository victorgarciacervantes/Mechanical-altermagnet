\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Simulation data of altermagnetic cross cell, with and without disorder.} The phase of each unit is shown as time evolves. The parameters of the simulation: $k_0 = 2 \hskip 1em\relax k_c = 10 \hskip 1em\relax k_a = 10 \hskip 1em\relax k_b = 3$. \textbf  {\ref {fig:cross_am_sym}} Simulation with no disorder: $\gamma =1$ for all units. Units with same chirality synchronize. The passive unit alternates evenly between synchronization with positive and negative chiralities, yielding a seesaw line. \textbf  {\ref {fig:cross_am_damping}} Simulation with quenched disorder in the damping: $\gamma = (1.1, 1.3, 1.2, 1.4, 1.5)$. Units with the same chirality do not synchronize. The passive unit alternates between bistable states chaotically. }}{53}{figure.caption.27}\protected@file@percent }
\newlabel{fig:cross_am_simulation}{{24}{53}{\textbf {Simulation data of altermagnetic cross cell, with and without disorder.} The phase of each unit is shown as time evolves. The parameters of the simulation: $k_0 = 2 \quad k_c = 10 \quad k_a = 10 \quad k_b = 3$. \textbf {\ref {fig:cross_am_sym}} Simulation with no disorder: $\gamma =1$ for all units. Units with same chirality synchronize. The passive unit alternates evenly between synchronization with positive and negative chiralities, yielding a seesaw line. \textbf {\ref {fig:cross_am_damping}} Simulation with quenched disorder in the damping: $\gamma = (1.1, 1.3, 1.2, 1.4, 1.5)$. Units with the same chirality do not synchronize. The passive unit alternates between bistable states chaotically}{figure.caption.27}{}}
